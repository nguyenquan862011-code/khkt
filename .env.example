# TamGiang Physics — biến môi trường của máy chủ (KHÔNG commit tệp .env thật).
# Mọi biến đều không bắt buộc: thiếu thì tính năng tương ứng tự tắt, website vẫn chạy cho khách.

# Nơi lưu cơ sở dữ liệu tài khoản (SQLite). Cần ổ đĩa bền vững; mặc định ./data
# TAMGIANG_DATA_DIR=/var/lib/tamgiang
# TAMGIANG_DB_FILE=/var/lib/tamgiang/tamgiang-accounts.sqlite

# Địa chỉ công khai của website, dùng trong liên kết email và đăng nhập Google
# TAMGIANG_PUBLIC_URL=https://vatly.thpttamgiang.example

# Email (cách nhau bằng dấu phẩy) được cấp quyền quản trị/giáo viên khi đăng ký
# TAMGIANG_ADMIN_EMAILS=giaovien@example.com

# Gửi email xác minh / đặt lại mật khẩu qua Resend. Thiếu ⇒ học sinh đặt lại bằng mã khôi phục.
# RESEND_API_KEY=
# TAMGIANG_MAIL_FROM="TamGiang Physics <no-reply@example.com>"
# Chỉ dùng khi phát triển: in liên kết email ra log thay vì gửi thật
# TAMGIANG_DEV_MAIL=1

# Đăng nhập Google (OAuth 2.0 Web client). Redirect URI: <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
